    {
        "id": "3a7f7ba997c9ed4f",
        "type": "function",
        "z": "bf424b7fa28ce733",
        "name": "Decode State",
        "func": "const data = msg.payload.data;\n// Buffer also supplied by Modbus implementation, enables reading and writing\n// signed integers, floats etc.\nconst buffer = msg.payload.buffer;\n// Address offset\nconst offset = -0x6006;\n\nconst running = Boolean(data[0x6006 + offset] & 1<<3);\nconst fault = Boolean(data[0x6006 + offset] & 1<<6);\nconst heatsink_temp = data[0x6007 + offset] * 0.1;\nconst hs_voltage = data[0x6008 + offset] * 0.1;\nconst ls_voltage = data[0x600C + offset] * 0.1;\n// Signed 16-Bit integer can be read from Node.js Buffer returned by Modbus implementation\nconst ls_current = buffer.readInt16BE(2*(0x600D + offset)) * 0.1;\nconst ls_power_kw = data[0x600E + offset] * 0.1;\nconst ambient_temp = data[0x600F + offset] * 0.1;\nconst derated_power_kw = data[0x6010 + offset] * 0.1;\nconst mppt_boost_uncontrolled_rectification_closure = Boolean(data[0x6011 + offset]);\nconst dehumidification_running = Boolean(data[0x6012 + offset]);\nconst insulation_resistance_pos_megohm = data[0x6013 + offset] * 0.001;\nconst insulation_resistance_neg_megohm = data[0x6014 + offset] * 0.001;\nconst insulation_detections_ctr = data[0x6015 + offset];\nconst insulation_detection_running = Boolean(data[0x6016 + offset]);\n\nmsg.payload = {\n    running,\n    fault,\n    heatsink_temp,\n    hs_voltage,\n    ls_voltage,\n    ls_current,\n    ls_power_kw,\n    ambient_temp,\n    derated_power_kw,\n    mppt_boost_uncontrolled_rectification_closure,\n    dehumidification_running,\n    insulation_resistance_pos_megohm,\n    insulation_resistance_neg_megohm,\n    insulation_detections_ctr,\n    insulation_detection_running\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 300,
        "y": 1400,
        "wires": [
            [
                "d86574f611caf528",
                "3a2268f78304924f",
                "f5fb43af833e1f08",
                "cb9e7abcbc1110a4",
                "7aeda309ee7d700d",
                "903edde8aa207e26",
                "c9f42109799ea41a"
            ]
        ]
    },
    {
        "id": "f08425aa11de07e8",
        "type": "function",
        "z": "bf424b7fa28ce733",
        "name": "Get Live Data",
        "func": "msg.payload = {\n    'fc': 3,\n    'unitid': 1,\n    'address': 0x6006,\n    'quantity': 0x6016 - 0x6006 + 1\n};\nmsg.topic = \"get_state\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 240,
        "y": 1280,
        "wires": [
            [
                "f6ec246e283a8fc3"
            ]
        ]
    },

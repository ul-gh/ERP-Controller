        "name": "Set Power Setpoint",
        "func": "const to_int16_complement = global.get(\"to_int16_complement\");\n\nconst value_min = -55;\nconst value_max = 55;\nconst value_lim = Math.min(Math.max(msg.payload, value_min), value_max);\n\nmsg.payload = {\n    'fc': 6,\n    'unitid': 1,\n    'address': 0x6106,\n    'value': to_int16_complement(10 * value_lim),\n    'quantity': 1\n};\n\nreturn msg;",
        "outputs": 1,

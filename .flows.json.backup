    {
        "id": "165bef812646e484",
        "type": "function",
        "z": "bf424b7fa28ce733",
        "name": "Decode State",
        "func": "const data = msg.payload.data;\n// Buffer also supplied by Modbus implementation, enables reading and writing\n// signed integers, floats etc.\nconst buffer = msg.payload.buffer;\n// Address offset\nconst offset = -0x6100;\n\nconst ls_voltage_setpoint = data[0x6100 + offset] * 0.1;\nconst ls_ovp = data[0x6101 + offset] * 0.1;\nconst ls_uvp = data[0x6102 + offset] * 0.1;\nconst hs_voltage_setpoint = data[0x6103 + offset] * 0.1;\nconst hs_ovp = data[0x6104 + offset] * 0.1;\nconst hs_uvp = data[0x6105 + offset] * 0.1;\nconst power_setpoint = data[0x6106 + offset] * 0.1;\n// Signed 16-Bit integer can be read from Node.js Buffer returned by Modbus implementation\nconst current_setpoint = buffer.readInt16BE(2 * (0x6107 + offset)) * 0.1;\nconst mpp_open_circuit_voltage = data[0x6108 + offset] * 0.1;\nconst autostart_enabled = Boolean(data[0x6109 + offset]);\nconst dcdc_enabled = Boolean(data[0x610A + offset]);\nconst parameters_fixed = Boolean(data[0x610B + offset]);\nconst power_limit = data[0x610D + offset] * 0.1;\nconst current_limit = data[0x610E + offset] * 0.1;\n\nreturn [\n    { payload: dcdc_enabled },\n    { payload: autostart_enabled },\n    { payload: parameters_fixed },\n    { payload: ls_voltage_setpoint },\n    { payload: current_setpoint },\n    { payload: hs_voltage_setpoint },\n    { payload: power_setpoint },\n    { payload: ls_ovp },\n    { payload: ls_uvp },\n    { payload: hs_ovp },\n    { payload: hs_uvp },\n    { payload: power_limit },\n    { payload: current_limit },\n];",
        "outputs": 13,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 460,
        "wires": [
            [
                "892b305e7bd31cd3"
            ],

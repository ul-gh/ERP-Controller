                "e2dd7ea41153949e"
            ]
        ]
    },
    {
        "id": "956580d285ad40b5",
        "type": "function",
        "z": "bf424b7fa28ce733",
        "name": "Set Current Setpoint",
        "func": "const to_int16_complement = global.get(\"to_int16_complement\");\n\nmsg.payload = {\n    'fc': 6,\n    'unitid': 1,\n    'address': 0x6107,\n    'value': to_int16_complement(10 * msg.payload),\n    'quantity': 1\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 980,
        "y": 440,
        "wires": [
            [
                "e2dd7ea41153949e"
            ]
        ]
    },
    {
        "id": "a258c4111ab8e3e0",
        "type": "function",
        "z": "bf424b7fa28ce733",
        "name": "Fast Setup",
        "func": "// INT16, Read/Write, quickly and easily configure DCDC mode at address 0x610C:\n// 0- No effect\n// 1- Constant voltage (current) on the high voltage side\n// 2- Constant voltage (power) on the high voltage side\n// 3- Constant voltage (current) on the low voltage side\n// 4- Constant voltage (power) on the low voltage side\n// 5- Battery charging and discharging (current)\n// 6- Battery charging and discharging(power)\n// 7- Vanadium REDOX flow battery charging and discharging (current)\n// 8- Vanadium REDOX flow battery charging and discharging (power)\n// 9- Boost MPPT\n// 10- Boost MPPT (with precharge)\n// 11- Step-down MPPT\n\nconst operation_mode = 3;\n\nmsg.payload = {\n    'fc': 6,\n    'unitid': 1,\n    'address': 0x611D,\n    'value': operation_mode,\n    'quantity': 1\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 950,
        "y": 40,
        "wires": [
            [
                "e2dd7ea41153949e"
            ]
        ]
    },

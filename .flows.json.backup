    {
        "id": "676aadec01199dcc",
        "type": "function",
        "z": "bf424b7fa28ce733",
        "name": "Set LS Voltage",
        "func": "const v_min = 0;\nconst v_max = 900;\n\nmsg.payload = {\n    'fc': 6,\n    'unitid': 1,\n    'address': 0x6100,\n    'value': 10 * Math.min(Math.max(msg.payload, v_min), v_max),\n    'quantity': 1\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 960,
        "y": 400,
        "wires": [

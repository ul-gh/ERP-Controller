    {
        "id": "b4979f56d9b59511",
        "type": "function",
        "z": "821d298e5389a95d",
        "name": "Decode State",
        "func": "const data = msg.payload.data;\n// Buffer also supplied by Modbus implementation, enables reading and writing\n// signed integers, floats etc.\nconst buffer = msg.payload.buffer;\n// Address offset\nconst offset = -0x6020;\n\nconst hw_fault_1 = data[0x6020 + offset];\nconst hw_fault_2 = data[0x6021 + offset];\nconst dcdc_fault = data[0x6022 + offset];\nconst hv_side_fault = data[0x6023 + offset];\nconst paralleling_fault = data[0x6024 + offset];\nconst system_fault = data[0x6025 + offset];\nconst switch_fault = data[0x6026 + offset];\nconst other_fault = data[0x6027 + offset];\n\nmsg.payload = {\n    hw_fault_1,\n    hw_fault_2,\n    dcdc_fault,\n    hv_side_fault,\n    paralleling_fault,\n    system_fault,\n    switch_fault,\n    other_fault\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 180,
        "wires": [
            [
                "e3374aab1534f03d"
            ]
        ]
    },

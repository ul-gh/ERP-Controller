    {
        "id": "fb4d9ac649fe1484",
        "type": "modbus-flex-getter",
        "z": "bf424b7fa28ce733",
        "name": "Modbus Get",
        "showStatusActivities": false,
        "showErrors": false,
        "showWarnings": true,
        "logIOActivities": false,
        "server": "1a20cd22136af87b",
        "useIOFile": false,

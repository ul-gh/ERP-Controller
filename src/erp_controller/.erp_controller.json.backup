    {
        "id": "b3a08e7a3f77a4e1",
        "type": "function",
        "z": "bd71ca1db613388c",
        "name": "Decode ACDC (CAN 2.0 EF) Protocol",
        "func": "/** Decode raw CAN input frame received from ACDC HW Controller.\n * \n * FIXME: No Security or Integrity Checking.\n * \n * This receives frames with integrity protected by HW.\n * There is NO secure filtering of invalid input rames, only HW safety.\n * \n * Possibly implement further frame ID or integrity error checking\n * for increased reliability, otherwise security is TBD.\n * \n **/\n\n\n// This is the controller or gateway ID (this application)\nconst CAN_ID_CONTROLLER = 0xF0;\n// Enable this to listen to all traffic\nconst PROMISCUOUS_MODE = false;\n\n// Infypower uses a 29-Bit CAN Extended Frame ID for additional information\nconst CAN_MASK_SRC = 0xFF;\nconst CAN_MASK_DEST = 0xFF << 8;\nconst CAN_MASK_CMD = 0b111111 << 16;\nconst CAN_MASK_DEVICE = 0b1111 << 22;\nconst CAN_MASK_ERROR = 0b111 << 26;\n\nconst dest_id = (msg.payload.canid & CAN_MASK_DEST) >> 8;\n\n// Reject all frames not addressed to us\nif (! PROMISCUOUS_MODE && dest_id !== CAN_ID_CONTROLLER) {\n    return;\n}\n\n// Decode more data encoded in Infypower 29-Bit CAN Extended Frame ID\nconst src_id = msg.payload.canid & CAN_MASK_SRC;\nconst command = (msg.payload.canid & CAN_MASK_CMD) >> 16;\nconst device_no = (msg.payload.canid & CAN_MASK_DEVICE) >> 22;\nconst error_code = (msg.payload.canid & CAN_MASK_ERROR) >> 26;\nlet error_str = \"\";\nif (error_code == 0x02) {\n    error_str = \"Command Invalid\";\n} else if (error_code == 0x03) {\n    error_str = \"Data Invalid\";\n} else if (error_code == 0x07) {\n    error_str = \"In Start Processing\";\n}\n\nmsg.payload = {\n    src_id,\n    dest_id,\n    command,\n    device_no,\n    error_code,\n    error_str,\n    data: msg.payload.data,\n    rawData: msg.payload.rawData\n}\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 250,
        "y": 260,
        "wires": [
            [
                "17b6a9d91e244658",
                "ea1d03c67246b902",
                "aa0bdc27a5f03041",
                "6b1b3157fd6d128d",
                "c9b7f5e99f3b9f0f",
                "ad70b0f6dee9ee68"
            ]
        ]
    },
    {
        "id": "4863d0e87879acc5",
        "type": "function",
        "z": "bd71ca1db613388c",
        "name": "Encode ACDC (CAN 2.0 EF) Device Query",
        "func": "/* Send Command to Individual Device or Broadcast ID.\n\nThis takes the below shown message scheme and creates the\ndata frame for sending with node-red-socketcan node.\n\nmsg.payload = {\n    dest_id: 0x3F,\n    command: 0x01,\n    data: [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],\n};\n\n*/\n\n// Controller or gateway address number, default is 0xF0\nconst ID_CONTROLLER = 0xF0;\n// Device number indicating the dest address is a single device or broadcast ID\nconst DEV_NO_SINGLE = 0x0A;\n\n\nconst infypower_can_id = (\n    // Source ID\n    ID_CONTROLLER\n    // Dest ID\n    | (msg.payload.dest_id & 0xFF) << 8\n    // Command no\n    | (msg.payload.command & 0b111111) << 16\n    // Device no\n    | DEV_NO_SINGLE << 22\n    // Error code is zero for outgoing commands\n);\n\nmsg.payload = {\n    canid: infypower_can_id,\n    data: msg.payload.data,\n    dlc: msg.payload.data.length,\n    ext: true,\n    canfd: false,\n    rtr: false,\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 970,
        "y": 840,
        "wires": [
            [
                "ef6f6428dd457c8f"
            ]
        ]
    },
    {
        "id": "1b26bf41077458b4",
        "type": "function",
        "z": "bd71ca1db613388c",
        "name": "Infypower Protocol",
        "func": "// Reject internal communication frame between modules\nconst CAN_BASE_INTERNAL_COM = 0x0757F800;\nconst CAN_MASK_INTERNAL_COM = 0xFFFFFF00;\nlet id = msg.payload.canid & CAN_MASK_INTERNAL_COM;\nif (id == CAN_BASE_INTERNAL_COM) {\n    return;\n}\n\n// Reject frames from this or other controller/gateway\nconst CAN_BASE_CONTROLLER = 0xF0;\nconst CAN_END_CONTROLLER = 0xF8;\nconst CAN_MASK_SRC = 0xFF;\nid = msg.payload.canid & CAN_MASK_SRC;\nif (id >= CAN_BASE_CONTROLLER && id <= CAN_END_CONTROLLER) {\n    return;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 1300,
        "wires": [
            []
        ]
    },
    {
        "id": "476111c64ae3e198",
        "type": "function",
        "z": "bd71ca1db613388c",
        "name": "Send Group CMD",
        "func": "/* Send Group CMD to CAN-connected chargers.\n\nThis takes the below shown message scheme and creates the\ndata frame for sending with node-red-socketcan node.\n\nmsg.payload = {\n    group_id: 0x00,\n    command: 0x01,\n    data: [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],\n};\n\n*/\n\n// This is the controller or gateway address number, default is 0xF0\nconst ID_CONTROLLER = 0xF0;\n// Device number indicating dest address is a group address\nconst DEV_NO_GROUP = 0x0B\n\n\nconst infypower_can_id = (\n    // Source ID\n    ID_CONTROLLER\n    // Dest ID\n    | (msg.payload.group_id & 0xFF) << 8\n    // Command No\n    | (msg.payload.command & 0b111111) << 16\n    // Device No\n    | DEV_NO_GROUP << 22\n    // Error code is zero for outgoing commands\n);\n\nmsg.payload = {\n    canid: infypower_can_id,\n    data: msg.payload.data,\n    dlc: msg.payload.data.length,\n    ext: true,\n    canfd: false,\n    rtr: false,\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 130,
        "y": 1300,
        "wires": [
            []
        ]
    },
    {
        "id": "b262f2813ccc0db6",
        "type": "function",
        "z": "bd71ca1db613388c",
        "name": "Query System Voltage and Current",
        "func": "msg.payload = {\n    // Broadcast address\n    dest_id: 0x3F,\n    // Read system information, voltage and current\n    command: 0x01,\n    data: [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 1000,
        "wires": [
            [
                "4863d0e87879acc5"
            ]
        ]
    },
    {
        "id": "ea1d03c67246b902",
        "type": "function",
        "z": "bd71ca1db613388c",
        "name": "Filter System Voltage and Current",
        "func": "// All other messages are rejected.\nif (msg.payload.command != 0x01) {\n    return;\n}\n\nconst voltage = msg.payload.rawData.readFloatBE();\nconst current = msg.payload.rawData.readFloatBE(4);\n\nreturn [\n    {topic: \"Voltage\", payload: voltage},\n    {topic: \"Current\", payload: current},\n];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 140,
        "wires": [
            [
                "f582ee629a197e1e"
            ],
            [
                "fe8e2410db5b9956"
            ]
        ]
    },
    {
        "id": "aa0bdc27a5f03041",
        "type": "function",
        "z": "bd71ca1db613388c",
        "name": "Filter System Module Count",
        "func": "// All other messages are rejected.\nif (msg.payload.command != 0x02) {\n    return;\n}\n\nconst n_modules = msg.payload.data[2];\n\nreturn {topic: \"System Module Count\", payload: n_modules};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 340,
        "wires": [
            [
                "23d8ee8292d0ba08"
            ]
        ]
    },
    {
        "id": "df5e6d1a302a31ef",
        "type": "function",
        "z": "bd71ca1db613388c",
        "name": "Query System Module Count",
        "func": "msg.payload = {\n    // Broadcast address\n    dest_id: 0x3F,\n    command: 0x02,\n    data: [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 840,
        "wires": [

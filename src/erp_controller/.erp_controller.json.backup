        "name": "Write transient switching register",
        "func": "const dcdc_set_reg = global.get(\"dcdc_functions.set_reg\");\n\nconst power_setpoint_kw = 5.0;\n\nreturn dcdc_set_reg(0x6110, 10 * power_setpoint_kw);",

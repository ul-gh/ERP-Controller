    {
        "id": "da980eef18280b40",
        "type": "function",
        "z": "bd71ca1db613388c",
        "name": "Set System Current (fixed voltage)",
        "func": "const v_sp = flow.get(\"voltage_setpoint\");\nconst i_sp = flow.get(\"current_setpoint\");\n\nif (v_sp === undefined || i_sp === undefined) {\n    node.error(\"Received undefined setpoint value\");\n    return;\n};\n\nconst buffer = Buffer.allocUnsafe(8);\nbuffer.writeUInt32BE(v_sp * 1000);\nbuffer.writeUInt32BE(i_sp * 1000, 4);\n\nmsg.payload = {\n    // Broadcast address\n    dest_id: 0x3F,\n    command: 0x1B,\n    data: Array.from(buffer.values()),\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 920,
        "wires": [

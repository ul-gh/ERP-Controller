    {
        "id": "35e140dca2b906ff",
        "type": "function",
        "z": "bf424b7fa28ce733",
        "name": "Decode Interlock State",
        "func": "// Bit 1 in HW Fault Word 1 is EPO <==> Emergency Power Off.\n// HV Interlock State Active (green) means no EPO or interlock state closed.\nconst interlock_closed = (msg.payload.data[0] & 1<<0) === 0;\n\nmsg.payload = interlock_closed;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 980,
        "y": 420,
        "wires": [
            [
                "316b3a7072c11291"
            ]
        ]
    },
    {
        "id": "a19ad1af90deb756",
        "type": "function",
        "z": "bf424b7fa28ce733",
        "name": "Do Power Control",
        "func": "const uds_input = global.get(\"uds_input\");\nif (uds_input === undefined) {\n    return;\n}\n\n// SOC target in percent.\nconst SOC_TARGET = 80;\n// Additional power for bank balancing when main SOC not reached in W.\nconst P_BANK_BALANCING = 3.0e3;\n// Minimum power consumption threshold for activating DCDC support.\nconst P_THRESHOLD = 2.0e3;\n// Minimum HV voltage for DCDC support\nconst HV_VOLTAGE_MIN = 330;\n// Maximum HV voltage for DCDC support\nconst HV_VOLTAGE_MAX = 450;\n// Minimum HV current for DCDC support\nconst HV_CURRENT_MIN = 330;\n// Maximum HV current for DCDC support\nconst HV_CURRENT_MAX = 450;\n// Minimum SOC for DCDC support\nconst SOC_MIN = 5.0;\n// Maximum SOC for DCDC support\nconst SOC_MAX = 90.0;\n\n// Output setpoint low limit in W\nconst SETPOINT_MIN = 0.0;\n// Output setpoint high limit in W\nconst SETPOINT_MAX = 18.0e3;\n\n// DCDC Converter Efficiency in units of one.\nconst EFF_DCDC = 0.99;\n\n// Get state data\nconst dcdc_power = EFF_DCDC * msg.payload.ls_power;\nconst hv_voltage = uds_input.HV_V;\nconst hv_current = uds_input.HV_A;\nconst soc = uds_input.SOC;\n\n// Calculate vehicle HV system power consumption excluding the DCDC.\nconst dcdc_hs_current= dcdc_power / hv_voltage;\nconst i_consumed = hv_current - dcdc_hs_current;\nconst p_consumed = i_consumed * hv_voltage\n\n// Leave setpoint at 0.0 if minimum power threshold is not reached.\nlet p_request = 0.0;\nif (p_consumed > P_THRESHOLD) {\n    if (soc < SOC_TARGET) {\n        p_request += P_BANK_BALANCING;\n    }\n    p_request = Math.max(Math.min(p_request, SETPOINT_MAX), SETPOINT_MIN);\n}\n\n// Check sanity and range limits of input values.\nif (hv_voltage < HV_VOLTAGE_MIN\n    || hv_voltage > HV_VOLTAGE_MAX\n    || hv_current < HV_CURRENT_MIN\n    || hv_current > HV_CURRENT_MAX\n    || soc < SOC_MIN\n    || soc > SOC_MAX\n) {\n    p_request = 0.0;\n}\n\nreturn {\n    topic: \"set_power\",\n    payload: p_request,\n};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 820,
        "wires": [
            [
                "4eb57b375586ce89",
                "b1b6a1f67ce60a5d",
                "ed8d96cd8ce06779"
            ]
        ]
    },

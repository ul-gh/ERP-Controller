    {
        "id": "0f8412c3617612c2",
        "type": "function",
        "z": "821d298e5389a95d",
        "name": "Write transient switching register",
        "func": "const dcdc_set_reg = global.get(\"dcdc_functions.set_reg\");\n\nconst value = 1;\n\nreturn dcdc_set_reg(0x6113, value);",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",

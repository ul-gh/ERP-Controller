    {
        "id": "c9b7f5e99f3b9f0f",
        "type": "function",
        "z": "bd71ca1db613388c",
        "name": "Filter AC Voltages",
        "func": "// All other messages are rejected.\nif (msg.payload.command != 0x06) {\n    return;\n}\n\nconst v_ab = 0.1 * msg.payload.rawData.readUInt16BE();\nconst v_bc = 0.1 * msg.payload.rawData.readUInt16BE(2);\nconst v_ca = 0.1 * msg.payload.rawData.readUInt16BE(4);\n\nreturn [\n    { topic: \"v_ab\", payload: v_ab },\n    { topic: \"v_bc\", payload: v_bc },\n    { topic: \"v_ca\", payload: v_ca },\n    { topic: \"v_avg\", payload: 1/3 * (v_ab + v_bc + v_ca) },\n];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 200,
        "wires": [
            [],
            [],
            [],
            [
                "273b634a96dcd5b8"
            ]
        ]
    },
    {
        "id": "ad70b0f6dee9ee68",
        "type": "function",
        "z": "bd71ca1db613388c",
        "name": "Filter Operating Range Margins",
        "func": "// All other messages are rejected.\nif (msg.payload.command != 0x0A) {\n    return;\n}\n\nconst v_max = msg.payload.rawData.readUInt16BE();\nconst v_min = msg.payload.rawData.readUInt16BE(2);\nconst i_max = 0.1 * msg.payload.rawData.readUInt16BE(4);\nconst p_max = 10 * msg.payload.rawData.readUInt16BE(6);\n\nreturn {\n    payload: {\n        v_max,\n        v_min,\n        i_max,\n        p_max\n    },\n    topic: \"Operating Range Margins\",\n};\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 670,
        "y": 380,
        "wires": [
            [
                "23d8ee8292d0ba08"
            ]

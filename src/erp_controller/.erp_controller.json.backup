                "4863d0e87879acc5"
            ]
        ]
    },
    {
        "id": "6b1b3157fd6d128d",
        "type": "function",
        "z": "bd71ca1db613388c",
        "name": "Filter Module Group ID, Temperature and State",
        "func": "// All other messages are rejected.\nif (msg.payload.command != 0x04) {\n    return;\n}\n\nconst group_id = msg.payload.data[2];\nconst temperature = msg.payload.rawData.readInt8(4);\nconst hw_state = msg.payload.data.splice(5, 8);\n\nreturn [\n    { topic: \"Group\", payload: group_id },\n    { topic: \"Temperature\", payload: temperature },\n    { topic: \"State\", payload: hw_state },\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 720,
        "y": 260,
        "wires": [
            [],
            [
                "309df17945f5e299"
            ],
            []
        ]
    },
    {
        "id": "3d2072522b9cada6",
        "type": "function",
        "z": "bd71ca1db613388c",
        "name": "Query Module Group ID, Ambient Temperature and State",
        "func": "// For systems with only one module\nconst MODULE_ID = 0x00;\n\nmsg.payload = {\n    // Destination address\n    dest_id: MODULE_ID,\n    // Read system information, current and voltage\n    command: 0x04,\n    data: [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 530,
        "y": 1040,
        "wires": [
            [
                "4863d0e87879acc5"
            ]
        ]
    },
    {
        "id": "b165b788c1a11fad",
        "type": "function",
        "z": "bd71ca1db613388c",
        "name": "Set off_on",
        "func": "// Enable outputs if msg.payload is true\n\nconst enable_flags = msg.payload ? 0x00 : 0x01;\n\nmsg.payload = {\n    // Broadcast address\n    dest_id: 0x3F,\n    command: 0x1A,\n    data: [enable_flags, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00],\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,

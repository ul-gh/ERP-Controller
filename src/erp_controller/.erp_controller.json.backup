    {
        "id": "68a27cd5ec74e783",
        "type": "function",
        "z": "bd71ca1db613388c",
        "name": "Recover Bus Error",
        "func": "// Function node: detect bus-off and trigger recovery\nif (msg.payload.err && msg.payload.canid === 0x00000040) {\n    msg.reason = \"bus-off detected\";\n    return msg;\n}\nreturn null;",

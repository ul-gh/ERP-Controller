        "z": "821d298e5389a95d",
        "name": "Decode State",
        "func": "const value = msg.payload.data[0];\n\nmsg.payload = {\n    value: value,\n    enable_delayed_uvp: Boolean(value & 1 << 0),\n    uvp_delay_ls_hs_switch: Boolean(value & 1 << 1),\n    enable_cv_mode_after_cc_cp: Boolean(value & 1 << 2),\n    cc_cv_switch: Boolean(value & 1 << 3),\n    cp_cc_switch: Boolean(value & 1 << 4),\n    enable_dcdc_mode: Boolean(value & 1 << 6),\n    enable_hs_balancing: Boolean(value & 1 << 8),\n    enable_mppt_filtering: Boolean(value & 1 << 9),\n    dcdc_cv_ls_hs_switch: Boolean(value & 1 << 10),\n    enable_bidi_dcdc_voltage_control_current: Boolean(value & 1 << 11),\n    enable_mppt_boost_charging: Boolean(value & 1 << 12),\n    dcdc_mode: Boolean(value & 1 << 13),\n    mppt_mode: Boolean(value & 1 << 15)\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",

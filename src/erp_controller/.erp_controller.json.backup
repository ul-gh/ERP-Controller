    {
        "id": "eca4389ab041d22f",
        "type": "function",
        "z": "ef43eabf9f8a3cae",
        "name": "Set Global Application Context",
        "func": "// See also startup code in \"Start\" tab for global context definition!\nconst uds_input = global.get(\"uds_input\");\nif (uds_input === undefined) {\n    return;\n}\n\nconst mqtt_input = {\n    hv_v: msg.payload.HV_V,\n    hv_a: msg.payload.HV_A,\n    soc: msg.payload.SOC,\n    soh: msg.payload.SOH,\n    batt_temp: msg.payload.BATT_TEMP,\n}\n\nglobal.set(\"uds_input\", mqtt_input);\n\nreturn;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "const uds_input = {\n    HV_V: 500.0,\n    HV_A: 0.0,\n    SOC: 0.0,\n    SOH: 0.0,\n    BATT_TEMP: -40.0,\n};\n\nglobal.set(\"uds_input\", uds_input)\n",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 120,
        "wires": [
            []
        ]
    },

    {
        "id": "165bef812646e484",
        "type": "function",
        "z": "b61a0cfa33bc7279",
        "name": "Decode Settings",
        "func": "const dcdc_decode_settings = global.get(\"dcdc_functions.decode_settings\");\n\nconst settings = dcdc_decode_settings(msg.payload);\n\nreturn [\n    { payload: settings.dcdc_enabled },\n    { payload: settings.autostart_enabled },\n    { payload: settings.parameters_fixed },\n    { payload: settings.ls_voltage_setpoint },\n    { payload: settings.current_setpoint },\n    { payload: settings.hs_voltage_setpoint },\n    { payload: 0.001 * settings.power_setpoint },\n    { payload: settings.ls_ovp },\n    { payload: settings.ls_uvp },\n    { payload: settings.hs_ovp },\n    { payload: settings.hs_uvp },\n    { payload: 0.001 * settings.power_limit },\n    { payload: settings.current_limit },\n];",
        "outputs": 13,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 200,
        "y": 360,
